# Copy to .env.local and fill in. Never commit .env.local.

# TMDB → https://www.themoviedb.org/settings/api → "API Read Access Token"
# Server-only: no NEXT_PUBLIC_ prefix, so it is never sent to the browser.
TMDB_READ_TOKEN=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL (used for metadata / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
